# ════════════════════════════════════════════════════════════════
# 검증실 환경 변수. 이 파일을 .env.local 로 복사해 값을 채운다.
#   필수: Supabase 3개 + DATABASE_URL + ANTHROPIC_API_KEY + ENCRYPTION_KEY
#   채운 뒤: npm run setup → npm run doctor → npm run dev
# ════════════════════════════════════════════════════════════════

# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 브라우저로 보내지 않는다
SUPABASE_SERVICE_ROLE_KEY=
# npm run setup 이 마이그레이션을 넣을 때만 쓴다 (Project Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres.xxxx:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── LLM ───────────────────────────────────────────────────────────
# anthropic | mock (mock = 외부 호출 없이 고정 응답, 화면 연결 확인용)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
BASELINE_MODEL=claude-haiku-5-5
# 호출 비용 기록용 단가 (원 / 100만 토큰). 실제 계약 단가로 바꾼다
LLM_INPUT_PRICE_PER_MTOK_KRW=4200
LLM_OUTPUT_PRICE_PER_MTOK_KRW=21000
# 기준선 테스트 모델 단가 (BASELINE_MODEL)
BASELINE_INPUT_PRICE_PER_MTOK_KRW=1400
BASELINE_OUTPUT_PRICE_PER_MTOK_KRW=7000
# 프로젝트당 월 AI 사용 한도(원, 0 = 없음)와 사용자당 시간당 호출 수
PROJECT_MONTHLY_LLM_BUDGET_KRW=50000
LLM_CALLS_PER_HOUR=120

# ── 보안 ──────────────────────────────────────────────────────────
# 연동 도구(PostHog·Amplitude·Langfuse) 자격 증명 암호화 키. 32자 이상 아무 문자열
#   만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# 매일 예약 작업(/api/cron/daily) 보호. Vercel이면 같은 값을 프로젝트 환경 변수에 넣으면 자동으로 붙는다
CRON_SECRET=
# 운영자 화면(/admin)에 들어올 이메일, 쉼표로 구분
ADMIN_EMAILS=

# ── 서비스 ────────────────────────────────────────────────────────
# 기획서 PDF의 결과 제출 링크, 초대 메일, 기준선 평가 링크, 알림 메일 링크에 쓰인다
APP_URL=http://localhost:3000
# 약관을 바꾸면 날짜를 올린다 (사용자에게 다시 동의를 받는다)
TERMS_VERSION=2026-10-24

# ── 선택 ──────────────────────────────────────────────────────────
# 메일 알림 (Resend). 없으면 화면 알림만
RESEND_API_KEY=
MAIL_FROM=검증실 <noreply@your-domain.kr>
# WORKBank 유사 업무 검색 (없으면 수요 사전값을 비워 둔다. 판정에는 영향 없음)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Langfuse 비용(USD)을 원화로 바꿀 환율
USD_KRW=1400
